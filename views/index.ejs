<!DOCTYPE html>
<html>
<head>

<title>PasteHub</title>

<link rel="stylesheet" href="/style.css">

</head>

<body>

<div class="container">

    <!-- HEADER -->
    <header class="home-header">

        <div>
            <h1>PasteHub</h1>
            <p class="subtitle">
                Your simple paste manager
            </p>
        </div>

    </header>


    <!-- QUICK ACTIONS -->
    <div class="quick-actions">

        <a href="/create" class="action-card">
            <span class="action-icon">＋</span>

            <div>
                <strong>New Paste</strong>
                <small>Create a new paste</small>
            </div>
        </a>


        <a href="/folder/add" class="action-card">
            <span class="action-icon">📁</span>

            <div>
                <strong>New Folder</strong>
                <small>Organize your pastes</small>
            </div>
        </a>

    </div>


    <!-- FOLDERS -->
    <section class="home-section">

        <div class="section-header">

            <div>
                <h2>📁 Folders</h2>
                <p>Organize your pastes into folders</p>
            </div>

        </div>


        <% if (!folders || folders.length === 0) { %>

            <div class="empty-state">

                <div class="empty-icon">📁</div>

                <strong>No folders yet</strong>

                <p>
                    Create a folder to start organizing your pastes.
                </p>

                <a href="/folder/add">
                    <button>＋ Create Folder</button>
                </a>

            </div>

        <% } else { %>


            <div class="folder-grid">

                <% folders.forEach(folder => { %>

                    <%
                    const folderPastes = (pastes || []).filter(
                        paste => paste.folder === folder.name
                    );
                    %>


                    <div class="folder-card">

                        <a
                            class="folder-main"
                            href="/folder/<%= encodeURIComponent(folder.name) %>"
                        >

                            <div class="folder-icon">
                                📁
                            </div>

                            <div class="folder-info">

                                <strong>
                                    <%= folder.name %>
                                </strong>

                                <span>
                                    <%= folderPastes.length %>
                                    paste<%= folderPastes.length === 1 ? "" : "s" %>
                                </span>

                            </div>

                            <div class="folder-arrow">
                                →
                            </div>

                        </a>


                        <div class="folder-actions">

                            <a
                                href="/folder/rename/<%= encodeURIComponent(folder.name) %>"
                            >
                                <button>
                                    ✏️ Rename
                                </button>
                            </a>

                        </div>

                    </div>


                <% }) %>

            </div>


        <% } %>

    </section>


    <!-- OTHER PASTES -->
    <section class="home-section">

        <div class="section-header">

            <div>
                <h2>📦 Other Pastes</h2>
                <p>Pastes that aren't inside a folder</p>
            </div>

        </div>


        <%
        const noFolderPastes = (pastes || []).filter(
            paste => !paste.folder || paste.folder === "None"
        );
        %>


        <% if (noFolderPastes.length === 0) { %>

            <div class="empty-state">

                <div class="empty-icon">
                    📄
                </div>

                <strong>
                    No standalone pastes
                </strong>

                <p>
                    Create a paste without selecting a folder.
                </p>

            </div>


        <% } else { %>


            <div class="paste-list">

                <% noFolderPastes.forEach(paste => { %>

                    <div class="paste-card">

                        <div class="paste-main">

                            <a
                                href="/paste/<%= paste.id %>"
                                class="paste-title"
                            >
                                <%= paste.title %>
                            </a>


                            <div class="paste-meta">

                                <span>
                                    👁️ <%= paste.views %> views
                                </span>

                                <span>
                                    📅
                                    <%= new Date(paste.created).toLocaleString() %>
                                </span>

                            </div>

                        </div>


                        <div class="paste-actions">

                            <a
                                href="/edit/<%= paste.id %>?key=<%= paste.editKey %>"
                            >
                                <button>
                                    ✏️ Edit
                                </button>
                            </a>


                            <a
                                href="/paste/move/<%= paste.id %>"
                            >
                                <button>
                                    📁 Move
                                </button>
                            </a>

                        </div>

                    </div>

                <% }) %>

            </div>


        <% } %>

    </section>


</div>

</body>
</html>
