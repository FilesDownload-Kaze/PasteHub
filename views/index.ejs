<!DOCTYPE html>
<html>
<head>

<title>PasteHub</title>

<link rel="stylesheet" href="/style.css">

</head>

<body>

<div class="container">

<h1>PasteHub</h1>

<div class="top-buttons">

<a href="/create">
<button>➕ Create New Paste</button>
</a>

<a href="/folder/add">
<button>📁 Add Folder</button>
</a>

</div>


<!-- FOLDERS -->

<h2>📁 Folders</h2>

<% if (!folders || folders.length === 0) { %>

<p>No folders yet.</p>

<% } %>


<% (folders || []).forEach(folder => { %>

<div class="folder-box">

    <h3>
        📁
        <a href="/folder/<%= encodeURIComponent(folder.name) %>">
            <%= folder.name %>
        </a>
    </h3>

    <a href="/folder/rename/<%= encodeURIComponent(folder.name) %>">
        <button>✏️ Rename</button>
    </a>

    <%
    const folderPastes = pastes.filter(
        paste => paste.folder === folder.name
    );
    %>

    <p>
        <%= folderPastes.length %>
        paste<%= folderPastes.length === 1 ? "" : "s" %>
    </p>

</div>

<br>

<% }) %>


<!-- OTHER PASTES -->

<h2>📦 Other Pastes</h2>

<%
const noFolderPastes = (pastes || []).filter(
    paste => !paste.folder || paste.folder === "None"
);
%>


<% if (noFolderPastes.length === 0) { %>

<p>No standalone pastes.</p>

<% } %>


<% noFolderPastes.forEach(paste => { %>

<div class="paste-box">

    <h3>
        <a href="/paste/<%= paste.id %>">
            <%= paste.title %>
        </a>
    </h3>

    <p>
        👁️ Views: <%= paste.views %>
    </p>

    <p>
        📅 <%= new Date(paste.created).toLocaleString() %>
    </p>

    <a href="/edit/<%= paste.id %>?key=<%= paste.editKey %>">
        <button>✏️ Edit</button>
    </a>

    <a href="/paste/move/<%= paste.id %>">
        <button>📁 Move</button>
    </a>

</div>

<br>

<% }) %>


</div>

</body>
</html>
