<!DOCTYPE html>
<html>
<head>
<title>Create Paste</title>
<link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

<h1>Create New Paste</h1>

<form method="POST" action="/create">

<input 
type="text"
name="title"
placeholder="Paste Title"
>

<br><br>

<textarea
name="content"
rows="15"
placeholder="Paste your code/text here..."
></textarea>

<br><br>

<button type="submit">
Create Paste
</button>

</form>

</div>

</body>
</html>
