<!DOCTYPE html>
<html>
<head>

<title>PasteHub</title>

<link rel="stylesheet" href="/style.css">

</head>

<body>

<div class="container">

<h1>PasteHub</h1>

<div class="top-buttons">

<a href="/create">
<button>➕ Create New Paste</button>
</a>

<a href="/folder/add">
<button>📁 Add Folder</button>
</a>

</div>


<!-- FOLDERS -->
<h2>📁 Folders</h2>

<%
const folderMap = {};
const noFolderPastes = [];

pastes.forEach(paste => {

    if (!paste.folder || paste.folder === "None") {

        noFolderPastes.push(paste);

    } else {

        const folder = paste.folder;

        if (!folderMap[folder]) {
            folderMap[folder] = [];
        }

        folderMap[folder].push(paste);

    }

});
%>


<% if (Object.keys(folderMap).length === 0) { %>

<p>No folders yet.</p>

<% } %>


<% Object.keys(folderMap).forEach(folder => { %>

<div class="folder-box">

    <h3>
        📁
        <a href="/folder/<%= encodeURIComponent(folder) %>">
            <%= folder %>
        </a>
    </h3>

    <a href="/folder/rename/<%= encodeURIComponent(folder) %>">
        <button>✏️ Rename</button>
    </a>

    <p>
        <%= folderMap[folder].length %>
        paste<%= folderMap[folder].length === 1 ? "" : "s" %>
    </p>

</div>

<br>

<% }) %>


<!-- PASTES WITHOUT FOLDER -->
<h2>📦 Other Pastes</h2>

<% if (noFolderPastes.length === 0) { %>

<p>No standalone pastes.</p>

<% } %>


<% noFolderPastes.forEach(paste => { %>

<div class="paste-box">

    <h3>
        <a href="/paste/<%= paste.id %>">
            <%= paste.title %>
        </a>
    </h3>

    <p>
        👁️ Views: <%= paste.views %>
    </p>

    <p>
        📅 <%= new Date(paste.created).toLocaleString() %>
    </p>

    <a href="/edit/<%= paste.id %>?key=<%= paste.editKey %>">
        <button>✏️ Edit</button>
    </a>

    <a href="/paste/move/<%= paste.id %>">
        <button>📁 Move</button>
    </a>

</div>

<br>

<% }) %>


</div>

</body>
</html>
