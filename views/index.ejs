<!DOCTYPE html>
<html>
<head>

<title>PasteHub</title>

<link rel="stylesheet" href="/style.css">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

</head>

<body>

<div class="container">

    <!-- HEADER -->
    <header class="home-header">

        <h1>PasteHub</h1>

        <p class="subtitle">
            Your simple paste manager
        </p>

    </header>

<div style="display:flex;justify-content:flex-end;margin-bottom:20px;">
    <a href="/logout">
        <button class="logout-btn">🔴 Logout</button>
    </a>
</div>


    <!-- QUICK ACTIONS -->
    <div class="quick-actions">

        <a href="/create" class="action-card">
            <span class="action-icon">＋</span>

            <div>
                <strong>New Paste</strong>
                <small>Create a new paste</small>
            </div>
        </a>


        <a href="/folder/add" class="action-card">
            <span class="action-icon">📁</span>

            <div>
                <strong>New Folder</strong>
                <small>Organize your pastes</small>
            </div>
        </a>

    </div>


    <!-- FOLDERS -->
    <section class="home-section">

        <div class="section-header">

            <div>
                <h2>📁 Folders</h2>

                <p>
                    Organize your pastes
                </p>
            </div>

        </div>


        <% if (!folders || folders.length === 0) { %>

            <div class="empty-state">

                <div class="empty-icon">📁</div>

                <strong>No folders yet</strong>

                <p>
                    Create your first folder.
                </p>

            </div>

        <% } else { %>


            <div class="folder-list">

                <% folders.forEach(folder => { %>

                    <%
                    const folderPastes = (pastes || []).filter(
                        paste => paste.folder === folder.name
                    );
                    %>


                    <div class="folder-card">

                        <a
                            class="folder-main"
                            href="/folder/<%= encodeURIComponent(folder.name) %>"
                        >

                            <div class="folder-icon">
                                📁
                            </div>

                            <div class="folder-info">

                                <strong>
                                    <%= folder.name %>
                                </strong>

                                <span>
                                    <%= folderPastes.length %>
                                    paste<%= folderPastes.length === 1 ? "" : "s" %>
                                </span>

                            </div>

                            <span class="folder-arrow">
                                →
                            </span>

                        </a>


                        <!-- MENU -->
                        <div class="card-menu">

                            <button
                                type="button"
                                class="menu-button"
                                onclick="toggleMenu(this)"
                            >
                                ⋮
                            </button>


                            <div class="menu-dropdown">

                                <a
                                    href="/folder/rename/<%= encodeURIComponent(folder.name) %>"
                                >
                                    ✏️ Rename
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </section>


    <!-- OTHER PASTES -->
    <section class="home-section">

        <div class="section-header">

            <div>
                <h2>📦 Other Pastes</h2>

                <p>
                    Pastes outside folders
                </p>
            </div>

        </div>


        <%
        const noFolderPastes = (pastes || []).filter(
            paste => !paste.folder || paste.folder === "None"
        );
        %>


        <% if (noFolderPastes.length === 0) { %>

            <div class="empty-state">

                <div class="empty-icon">
                    📄
                </div>

                <strong>
                    No standalone pastes
                </strong>

                <p>
                    Create a paste to get started.
                </p>

            </div>


        <% } else { %>


            <div class="paste-list">

                <% noFolderPastes.forEach(paste => { %>

                    <div class="paste-card">

                        <a
                            href="/paste/<%= paste.id %>"
                            class="paste-main"
                        >

                            <strong class="paste-title">
                                <%= paste.title %>
                            </strong>


                            <div class="paste-meta">

                                <span>
                                    👁️ <%= paste.views %> views
                                </span>

                                <span>
                                    📅
                                    <%= new Date(paste.created).toLocaleString() %>
                                </span>

                            </div>

                        </a>


                        <!-- MENU -->
                        <div class="card-menu">

                            <button
                                type="button"
                                class="menu-button"
                                onclick="toggleMenu(this)"
                            >
                                ⋮
                            </button>


                            <div class="menu-dropdown">

                                <a
                                    href="/edit/<%= paste.id %>?key=<%= paste.editKey %>"
                                >
                                    ✏️ Edit
                                </a>

                                <a
                                    href="/paste/move/<%= paste.id %>"
                                >
                                    📁 Move
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </section>


</div>


<script>

function toggleMenu(button) {

    const menu = button.nextElementSibling;

    document.querySelectorAll(".menu-dropdown").forEach(function(item) {

        if (item !== menu) {
            item.classList.remove("show");
        }

    });

    menu.classList.toggle("show");

}


document.addEventListener("click", function(event) {

    if (!event.target.closest(".card-menu")) {

        document.querySelectorAll(".menu-dropdown").forEach(function(menu) {

            menu.classList.remove("show");

        });

    }

});

</script>

</body>
</html>
