<!DOCTYPE html>
<html>
<head>

<title><%= folder %> - PasteHub</title>

<link rel="stylesheet" href="/style.css">

</head>

<body>

<div class="container">

<h1>📁 <%= folder %></h1>

<a href="/">
<button>← Back to Folders</button>
</a>

<br><br>

<a href="/create?folder=<%= encodeURIComponent(folder) %>">
<button>➕ Create New Paste</button>
</a>

<h2>Pastes</h2>

<% if (pastes.length === 0) { %>

<p>This folder is empty.</p>

<% } %>

<% pastes.forEach(paste => { %>

<div class="paste-box">

<h3>
<a href="/paste/<%= paste.id %>">
<%= paste.title %>
</a>
</h3>

<p>
👁️ Views: <%= paste.views %>
</p>

<p>
📅 <%= new Date(paste.created).toLocaleString() %>
</p>

<a href="/edit/<%= paste.id %>?key=<%= paste.editKey %>">
<button>✏️ Edit</button>
</a>

</div>

<br>

<% }) %>

</div>

</body>
</html>
